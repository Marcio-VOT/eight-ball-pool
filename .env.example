# ==============================================================================
# 8 Ball Pool 2.5D — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local customization.
# NEVER commit `.env` or `.env.local` to Git.
#
# Note: This application runs with deterministic in-memory rooms and currently
# requires NO external API keys, database URLs, or third-party secrets.
# Add any future private credentials (DB, Redis, Auth, OAuth) only to `.env.local`
# locally and in your hosting provider's Environment / Secrets dashboard.

# Node environment (`development` locally, `production` in cloud deploys)
NODE_ENV=development

# HTTP + WebSocket port (Render/Koyeb/Railway inject PORT automatically)
PORT=3000

# Network interface (`localhost` for local dev, `0.0.0.0` in Docker/cloud)
HOST=localhost
